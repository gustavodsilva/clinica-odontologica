@model IEnumerable<ClinicaOdontologica.Models.ApplicationUser>

@{
    ViewData["Title"] = "Usuários";
}

<h2>Usuários</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Usuário</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Email
            </th>
            <th>
                Role
            </th>
            <th>
                Unidade
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @ViewBag.UserRoles[item.Id]
                </td>
                <td>
                    @(item.Unit?.Name ?? "Todas")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                    <a asp-controller="Account" asp-action="ResetPassword" asp-route-userId="@item.Id" class="btn btn-sm btn-warning">Resetar Senha</a>
                </td>
            </tr>
        }
    </tbody>
</table>

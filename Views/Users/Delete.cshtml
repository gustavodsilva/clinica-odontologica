@model ClinicaOdontologica.Models.DeleteUserViewModel

@{
    ViewData["Title"] = "Excluir Usuário";
}

<h2>Excluir Usuário</h2>

<div class="alert alert-danger">
    <h4>Tem certeza que deseja excluir este usuário?</h4>
    <p>Esta ação não pode ser desfeita.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8">@Model.Role</dd>

            <dt class="col-sm-4">Unidade</dt>
            <dd class="col-sm-8">@Model.Unit</dd>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

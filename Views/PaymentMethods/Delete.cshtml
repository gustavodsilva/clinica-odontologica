@model ClinicaOdontologica.Models.PaymentMethod

@{
    ViewData["Title"] = "Excluir Forma de Pagamento";
}

<h2>Excluir Forma de Pagamento</h2>

<h3>Tem certeza que deseja excluir esta forma de pagamento?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RequiresBrand)
        </dt>
        <dd class="col-sm-10">
            @(Model.RequiresBrand ? "Sim" : "Não")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RequiresInstallments)
        </dt>
        <dd class="col-sm-10">
            @(Model.RequiresInstallments ? "Sim" : "Não")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Active)
        </dt>
        <dd class="col-sm-10">
            @(Model.Active ? "Sim" : "Não")
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

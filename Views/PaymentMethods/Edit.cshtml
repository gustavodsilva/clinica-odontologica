@model ClinicaOdontologica.Models.PaymentMethod

@{
    ViewData["Title"] = "Editar Forma de Pagamento";
}

<h2>Editar Forma de Pagamento</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="RequiresBrand" class="form-check-input" type="checkbox" />
                    <label asp-for="RequiresBrand" class="form-check-label"></label>
                </div>
                <small class="text-muted">Marque se essa forma de pagamento usa bandeira de cartão</small>
                <span asp-validation-for="RequiresBrand" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="RequiresInstallments" class="form-check-input" type="checkbox" />
                    <label asp-for="RequiresInstallments" class="form-check-label"></label>
                </div>
                <small class="text-muted">Marque se essa forma de pagamento permite parcelamento</small>
                <span asp-validation-for="RequiresInstallments" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="Active" class="form-check-input" type="checkbox" />
                    <label asp-for="Active" class="form-check-label"></label>
                </div>
                <span asp-validation-for="Active" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

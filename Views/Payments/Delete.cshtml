@model ClinicaOdontologica.Models.Payment

@{
    ViewData["Title"] = "Excluir Pagamento";
}

<h2>Excluir Pagamento</h2>

<h3>Tem certeza que deseja excluir este pagamento?</h3>
<div>
    <h4>Pagamento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Código Paciente
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PatientCode)
        </dd>
        <dt class="col-sm-2">
            Data Pagamento
        </dt>
        <dd class="col-sm-10">
            @Model.PaymentDate.ToString("dd/MM/yyyy")
        </dd>
        <dt class="col-sm-2">
            Valor Bruto
        </dt>
        <dd class="col-sm-10">
            @Model.GrossAmount.ToString("C2")
        </dd>
        <dt class="col-sm-2">
            Forma Pagamento
        </dt>
        <dd class="col-sm-10">
            @(Model.PaymentMethod?.Name ?? "-")
            @(Model.CardBrand != null ? $" + {Model.CardBrand.Name}" : "")
            @(Model.Installments.HasValue ? $" ({Model.Installments}x)" : "")
        </dd>
        <dt class="col-sm-2">
            Taxa Aplicada
        </dt>
        <dd class="col-sm-10">
            @Model.FeePercentageApplied.ToString("F2")% (@Model.FeeAmount.ToString("C2"))
        </dd>
        <dt class="col-sm-2">
            Valor Líquido
        </dt>
        <dd class="col-sm-10">
            @Model.NetAmountExpected.ToString("C2")
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Model.Status
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
